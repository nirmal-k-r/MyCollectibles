<%- include('../partials/header') %>

<main class="admin-content">
	<section class="admin-heading">
		<div>
			<p class="eyebrow">Management</p>
			<h1>Product desk</h1>
			<p class="admin-intro">Keep the collection current, one beautiful object at a time.</p>
		</div>
		<button class="create-button" type="button" id="open-product-modal">+ Create product</button>
	</section>

	<% if (message!="None") { %>
		<div class="admin-success" role="status">
			<span aria-hidden="true">&#10003;</span>
			<p><%= message %></p>
			<button type="button" class="success-close" aria-label="Dismiss message">&times;</button>
		</div>
	<% } %>

	<section class="product-list" aria-labelledby="product-list-heading">
		<div class="section-heading">
			<h2 id="product-list-heading">All products</h2>
			<span><%= products.length %> item<%= products.length == 1 ? '' : 's' %></span>
		</div>

		<% if (products.length) { %>
			<% products.forEach((product) => { %>
				<article class="product-row">
					<% if (product.image) { %>
						<img src="<%= product.image %>" alt="<%= product.name %>">
					<% } else { %>
						<div class="product-placeholder" aria-hidden="true">MC</div>
					<% } %>
					<div class="product-details">
						<div class="product-title-line">
							<h3><a href="/admin/product/<%= product._id %>"><%= product.name %></a></h3>
							<div class="product-price-area">
								<strong>Rs <%= Number(product.price).toFixed(2) %></strong>

								<a class="delete-button" href="/admin/delete-product/<%= product._id %>">Delete</a>

							</div>
						</div>
						<p><%= product.description || 'No description added yet.' %></p>
						<div class="product-meta">
							<span><%= product.category || 'Uncategorised' %></span>
							<span><%= product.stock %> in stock</span>
						</div>
					</div>
				</article>
			<% }); %>
		<% } else { %>
			<p class="empty-products">No products yet. Create the first one.</p>
		<% } %>
	</section>

</main>

<div class="product-modal" id="product-modal" hidden>
	<!-- <div class="modal-backdrop" data-close-modal></div> -->
	<section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="modal-heading">
		<button class="modal-close" type="button" data-close-modal aria-label="Close">&times;</button>
		<p class="eyebrow">New collectible</p>
		<h2 id="modal-heading">Create product</h2>
		<form class="product-form" id="product-form" action="/admin/create-product" method="POST">
			<div class="form-field">
				<label for="product-name">Name</label>
				<input id="product-name" name="name" type="text" required>
			</div>
			<div class="form-field">
				<label for="product-description">Description</label>
				<textarea id="product-description" name="description" rows="3"></textarea>
			</div>
			<div class="form-grid">
				<div class="form-field">
					<label for="product-price">Price</label>
					<input id="product-price" name="price" type="number" min="0" step="0.01" required>
				</div>
				<div class="form-field">
					<label for="product-stock">Stock</label>
					<input id="product-stock" name="stock" type="number" min="0" step="1" value="0">
				</div>
			</div>
			<div class="form-field">
				<label for="product-category">Category</label>
				<select id="product-category" name="category" required>
					<option value="" disabled selected>Choose a category</option>
					<option value="Figurines">Figurines</option>
					<option value="Art">Art</option>
					<option value="Books">Books</option>
					<option value="Cards">Trading cards</option>
					<option value="Comics">Comics</option>
					<option value="Coins">Coins</option>
					<option value="Stamps">Stamps</option>
					<option value="Toys">Toys</option>
					<option value="Memorabilia">Memorabilia</option>
					<option value="Other">Other</option>
				</select>
			</div>
			<div class="form-field">
				<label for="product-image-file">Image</label>
				<input id="product-image-file" type="file" accept="image/*">
				<input id="image-value" name="image" type="hidden">
				<small id="image-status">Choose an image to upload.</small>
			</div>
			<button class="auth-submit" type="submit">Save product</button>
		</form>
	</section>
</div>

<script>
	const modal = document.getElementById('product-modal');
	const imageFile = document.getElementById('product-image-file');
	const imageValue = document.getElementById('image-value');
	const imageStatus = document.getElementById('image-status');
	const productForm = document.getElementById('product-form');
	let imageConversionPending = false;

	document.getElementById('open-product-modal').addEventListener('click', () => {
		modal.hidden = false;
		document.getElementById('product-name').focus();
	});

	document.querySelectorAll('[data-close-modal]').forEach((element) => {
		element.addEventListener('click', () => {
			modal.hidden = true;
		});
	});

	imageFile.addEventListener('change', () => {
		const file = imageFile.files[0];
		if (!file) return;

		imageConversionPending = true;
		const reader = new FileReader();
		reader.addEventListener('load', () => {
			imageValue.value = reader.result;
			imageConversionPending = false;
			imageStatus.textContent = `${file.name} ready to upload.`;
		});
		reader.readAsDataURL(file);
	});

	productForm.addEventListener('submit', (event) => {
		if (imageConversionPending) {
			event.preventDefault();
			imageStatus.textContent = 'Please wait for the image to finish processing.';
		}
	});

	const successMessage = document.querySelector('.admin-success');
	if (successMessage) {
		successMessage.querySelector('.success-close').addEventListener('click', () => {
			successMessage.remove();
		});
	}
</script>

<%- include('../partials/footer') %>