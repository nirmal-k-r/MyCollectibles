<%- include('../partials/header') %>

    <main class="home-content">
        <p class="eyebrow">Your collection, beautifully kept</p>
        <h1>Make room for the things<br>that tell your story.</h1>

        <section class="sale-section" aria-labelledby="sale-products-heading">
            <div class="sale-header-row">
                <h3 id="sale-products-heading">Items on sale</h3>
                <span class="sale-results-meta" id="sale-results-meta">Loading products...</span>
            </div>

            <div class="sale-controls" aria-label="Product filters">
                <div class="sale-search-wrap">
                    <label class="sr-only" for="sale-search">Search items</label>
                    <input id="sale-search" type="search" placeholder="Search collectibles" autocomplete="off">
                </div>
                <div class="sale-filter-wrap">
                    <label class="sr-only" for="sale-category">Filter by category</label>
                    <select id="sale-category">
                        <option value="all">All categories</option>
                        <% categories.forEach(category => { %>
                            <option value="<%= category %>"><%= category %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <!-- <div id="sale-products" class="sale-products" aria-live="polite">
                <% products.forEach(product => { %>
                    <article class="sale-product-card">
                        <div class="sale-product-image-wrap">
                            <img src="<%= product.image || 'https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=900&q=80' %>" alt="<%= product.name || 'Collectible' %>" class="sale-product-image" data-product-name="<%= product.name || 'Collectible' %>" data-product-image="<%= product.image || 'https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=900&q=80' %>" data-product-category="<%= product.category || 'General' %>" data-product-description="<%= product.description || 'A unique collectible with timeless appeal.' %>" data-product-price="<%= product.price || 0 %>">
                        </div>
                        <div class="sale-product-body">
                            <div class="sale-product-topline">
                                <span class="sale-category-pill"><%= product.category || 'General' %></span>
                                <strong class="sale-product-price"><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'MUR', maximumFractionDigits: 2 }).format(Number(product.price || 0)) %></strong>
                            </div>
                            <h4><%= product.name || 'Collectible' %></h4>
                            <button type="button" class="sale-product-button">Add to cart</button>
                        </div>
                    </article>
                <% }) %> -->
            </div>
            <div id="sale-loading" class="sale-loading" hidden>Loading more products...</div>
            <div id="sale-empty-state" class="sale-empty-state" hidden>No products match your search.</div>
        </section>
    </main>

    <div id="image-modal" class="image-modal" hidden>
        <div class="image-modal-backdrop" data-close="true"></div>
        <div class="image-modal-content" role="dialog" aria-modal="true" aria-labelledby="image-modal-title">
            <button class="image-modal-close" type="button" aria-label="Close image preview">×</button>
            <div class="image-modal-body">
                <div class="image-modal-visual">
                    <img id="image-modal-img" src="" alt="Full product preview">
                </div>
                <div class="image-modal-info">
                    <span id="image-modal-category" class="image-modal-category"></span>
                    <h3 id="image-modal-title">Product image</h3>
                    <div id="image-modal-price" class="image-modal-price"></div>
                    <p id="image-modal-description" class="image-modal-description"></p>
                    <div id="image-modal-tags" class="image-modal-tags"></div>
                    <div class="image-modal-actions">
                        <button type="button" class="image-modal-cart">Add to cart</button>
                        <button type="button" class="image-modal-favorite">Save item</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const saleProducts = document.getElementById('sale-products');
        const saleLoading = document.getElementById('sale-loading');
        const saleEmptyState = document.getElementById('sale-empty-state');
        const saleMeta = document.getElementById('sale-results-meta');
        const searchInput = document.getElementById('sale-search');
        const categorySelect = document.getElementById('sale-category');

        const state = {
            page: 1,
            limit: 6,
            keyword: '',
            category: 'all',
            loading: false,
            hasMore: true
        };

        const imageModal = document.getElementById('image-modal');
        const imageModalImg = document.getElementById('image-modal-img');
        const imageModalTitle = document.getElementById('image-modal-title');
        const imageModalCategory = document.getElementById('image-modal-category');
        const imageModalPrice = document.getElementById('image-modal-price');
        const imageModalDescription = document.getElementById('image-modal-description');
        const imageModalTags = document.getElementById('image-modal-tags');
        const imageModalClose = document.querySelector('.image-modal-close');

        function openImageModal(product) {
            imageModalImg.src = product.image;
            imageModalImg.alt = product.name;
            imageModalTitle.textContent = product.name;
            imageModalCategory.textContent = product.category || 'General';
            imageModalPrice.textContent = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'MUR',
                maximumFractionDigits: 2
            }).format(Number(product.price || 0));
            imageModalDescription.textContent = product.description || 'A unique collectible with timeless appeal.';

            const tagList = [
                product.category || 'General',
                'New arrival',
                'Limited edition',
                'Collector favorite'
            ];

            imageModalTags.innerHTML = tagList
                .map(tag => `<span class="image-modal-tag">${tag}</span>`)
                .join('');

            imageModal.hidden = false;
            document.body.style.overflow = 'hidden';
        }

        function closeImageModal() {
            imageModal.hidden = true;
            document.body.style.overflow = '';
            imageModalImg.src = '';
        }

        imageModalClose.addEventListener('click', closeImageModal);
        imageModal.addEventListener('click', (event) => {
            if (event.target.dataset.close === 'true' || event.target === imageModal) {
                closeImageModal();
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !imageModal.hidden) {
                closeImageModal();
            }
        });

        function createProductCard(product) {
            const name = product.name || 'Collectible';
            const description = product.description || 'A unique collectible with timeless appeal.';
            const category = product.category || 'General';
            const image = product.image || 'https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=900&q=80';
            const price = Number(product.price || 0);
            const formattedPrice = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'MUR',
                maximumFractionDigits: 2
            }).format(price);

            return `
                <article class="sale-product-card">
                    <div class="sale-product-image-wrap">
                        <img src="${image}" alt="${name}" class="sale-product-image" data-product-name="${name}" data-product-image="${image}" data-product-category="${category}" data-product-description="${description}" data-product-price="${price}" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517849845537-4d257902454a?auto=format&fit=crop&w=900&q=80';">
                    </div>
                    <div class="sale-product-body">
                        <div class="sale-product-topline">
                            <span class="sale-category-pill">${category}</span>
                            <strong class="sale-product-price">${formattedPrice}</strong>
                        </div>
                        <h4>${name}</h4>
                        <button type="button" class="sale-product-button">Add to cart</button>
                    </div>
                </article>
            `;
        }

        function renderProducts(products) {
            if (!products.length) {
                saleEmptyState.hidden = false;
                return;
            }

            saleEmptyState.hidden = true;
            saleProducts.insertAdjacentHTML('beforeend', products.map(createProductCard).join(''));

            saleProducts.querySelectorAll('.sale-product-image').forEach((imageNode) => {
                imageNode.addEventListener('click', () => {
                    const product = {
                        name: imageNode.dataset.productName,
                        image: imageNode.dataset.productImage,
                        category: imageNode.dataset.productCategory,
                        description: imageNode.dataset.productDescription,
                        price: imageNode.dataset.productPrice
                    };

                    openImageModal(product);
                });
            });
        }

        async function loadProducts(reset = false) {
            if (state.loading || (!state.hasMore && !reset)) return;

            state.loading = true;
            saleLoading.hidden = false;
            saleMeta.textContent = 'Loading products...';

            const pageToLoad = reset ? 1 : state.page;
            const params = new URLSearchParams({
                page: pageToLoad,
                limit: state.limit,
                keyword: state.keyword,
                category: state.category
            });

            try {
                const response = await fetch(`/products?${params.toString()}`);
                const data = await response.json();
                const products = data.products || [];

                if (reset) {
                    saleProducts.innerHTML = '';
                    state.page = 1;
                }

                renderProducts(products);

                if (products.length === 0) {
                    state.hasMore = false;
                } else {
                    state.page = pageToLoad + 1;
                    state.hasMore = Boolean(data.hasMore);
                }

                saleMeta.textContent = `${saleProducts.children.length} items available`;
                if (!state.hasMore) {
                    saleMeta.textContent = `${saleProducts.children.length} items found`;
                }
            } catch (error) {
                console.error('Error fetching products:', error);
                saleEmptyState.hidden = false;
                saleEmptyState.textContent = 'Something went wrong while loading products.';
            } finally {
                saleLoading.hidden = true;
                state.loading = false;
            }
        }

        function handleSearch() {
            state.keyword = searchInput.value.trim();
            state.category = categorySelect.value;
            state.hasMore = true;
            state.page = 1;
            loadProducts(true);
        }

        let searchTimer;
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(handleSearch, 250);
        });

        categorySelect.addEventListener('change', handleSearch);

        function checkScrollLoad() {
            const nearBottom = window.innerHeight + window.scrollY >= document.body.offsetHeight - 220;
            if (nearBottom && !state.loading && state.hasMore) {
                loadProducts();
            }
        }

        window.addEventListener('scroll', checkScrollLoad);

        loadProducts(true);
    </script>

<%- include('../partials/footer') %>