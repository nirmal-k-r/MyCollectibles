<%- include('../partials/header') %>

<main class="details-content">
	<div class="details-actions">
		<a class="back-button" href="/admin">&larr; Back to admin panel</a>

		<a class="delete-button" href="/admin/delete-product/<%= product._id %>">Delete</a>
	</div>

	<section class="details-panel">
		<div class="details-header">
			<p class="eyebrow">Product details</p>
			<h1><%= product.name %></h1>
		</div>

		<form class="product-form" id="details-form" action="/admin/product/<%= product._id %>/update" method="POST">
			<div class="form-field">
				<label for="product-name">Name</label>
				<input id="product-name" name="name" type="text" value="<%= product.name %>" required>
			</div>
			<div class="form-field">
				<label for="product-description">Description</label>
				<textarea id="product-description" name="description" rows="4"><%= product.description || '' %></textarea>
			</div>
			<div class="form-grid">
				<div class="form-field">
					<label for="product-price">Price</label>
					<input id="product-price" name="price" type="number" min="0" step="0.01" value="<%= product.price %>" required>
				</div>
				<div class="form-field">
					<label for="product-stock">Stock</label>
					<input id="product-stock" name="stock" type="number" min="0" step="1" value="<%= product.stock %>">
				</div>
			</div>
			<div class="form-field">
				<label for="product-category">Category</label>
				<select id="product-category" name="category" required>
					<option value="" disabled>Choose a category</option>
					<option value="Figurines" <%= product.category === 'Figurines' ? 'selected' : '' %>>Figurines</option>
					<option value="Art" <%= product.category === 'Art' ? 'selected' : '' %>>Art</option>
					<option value="Books" <%= product.category === 'Books' ? 'selected' : '' %>>Books</option>
					<option value="Cards" <%= product.category === 'Cards' ? 'selected' : '' %>>Trading cards</option>
					<option value="Comics" <%= product.category === 'Comics' ? 'selected' : '' %>>Comics</option>
					<option value="Coins" <%= product.category === 'Coins' ? 'selected' : '' %>>Coins</option>
					<option value="Stamps" <%= product.category === 'Stamps' ? 'selected' : '' %>>Stamps</option>
					<option value="Toys" <%= product.category === 'Toys' ? 'selected' : '' %>>Toys</option>
					<option value="Memorabilia" <%= product.category === 'Memorabilia' ? 'selected' : '' %>>Memorabilia</option>
					<option value="Other" <%= product.category === 'Other' ? 'selected' : '' %>>Other</option>
				</select>
			</div>
			<div class="form-field">
				<label for="product-image-file">Replace image</label>
				<div class="details-image-preview">
					<% if (product.image) { %>
						<img id="image-preview" src="<%= product.image %>" alt="Preview of <%= product.name %>">
					<% } else { %>
						<div id="image-preview" class="product-placeholder" aria-label="No product image">MC</div>
					<% } %>
				</div>
				<input id="product-image-file" type="file" accept="image/*">
				<input id="image-value" name="image" type="hidden" value="<%= product.image || '' %>">
				<small id="image-status"><%= product.image ? 'Current image will be kept unless replaced.' : 'Choose an image to upload.' %></small>
			</div>
			<button class="auth-submit" type="submit">Save changes</button>
		</form>
	</section>
</main>

<script>
	const detailsForm = document.getElementById('details-form');
	const imageFile = document.getElementById('product-image-file');
	const imageValue = document.getElementById('image-value');
	const imageStatus = document.getElementById('image-status');
	const imagePreview = document.getElementById('image-preview');
	let imageConversionPending = false;

	imageFile.addEventListener('change', () => {
		const file = imageFile.files[0];
		if (!file) return;

		imageConversionPending = true;
		const reader = new FileReader();
		reader.addEventListener('load', () => {
			imageValue.value = reader.result;
			if (imagePreview.tagName === 'IMG') {
				imagePreview.src = reader.result;
			} else {
				const previewImage = document.createElement('img');
				previewImage.id = 'image-preview';
				previewImage.alt = `Preview of ${file.name}`;
				previewImage.src = reader.result;
				imagePreview.replaceWith(previewImage);
			}
			imageConversionPending = false;
			imageStatus.textContent = `${file.name} ready to upload.`;
		});
		reader.readAsDataURL(file);
	});

	detailsForm.addEventListener('submit', (event) => {
		if (imageConversionPending) {
			event.preventDefault();
			imageStatus.textContent = 'Please wait for the image to finish processing.';
		}
	});
</script>

<%- include('../partials/footer') %>
