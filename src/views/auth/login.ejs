<%- include('../partials/header') %>

<main class="auth-content">
	<section class="auth-panel" aria-labelledby="login-title">
		<div class="auth-heading">
			<p class="eyebrow">Welcome back</p>
			<h1 id="login-title">Sign in</h1>
			<p>Pick up where you left off and keep your collectibles close.</p>
		</div>

		<form class="auth-form" action="/auth/login" method="POST">
			<div class="form-field">
				<label for="email">Email address</label>
				<input type="email" id="email" name="email" autocomplete="email" placeholder="you@example.com" required>
			</div>

			<div class="form-field">
				<div class="field-label-row">
					<label for="password">Password</label>
					<a href="#">Forgot password?</a>
				</div>
				<input type="password" id="password" name="password" autocomplete="current-password" placeholder="Enter your password" required>
			</div>

			<button class="auth-submit" type="submit">Sign in</button>
		</form>

		<p class="auth-switch">New to MyCollectibles? <a href="/auth/register">Create an account</a></p>
	</section>
</main>


<%- include('../partials/footer') %>
