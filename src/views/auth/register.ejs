<%- include('../partials/header') %>

<main class="auth-content">
	<section class="auth-panel register-panel" aria-labelledby="register-title">
		<div class="auth-heading">
			<p class="eyebrow">Start collecting</p>
			<h1 id="register-title">Create your account</h1>
			<p>Set up your personal space for the pieces and stories you want to keep close.</p>
		</div>

		<form class="auth-form register-form" action="/auth/register" method="POST">
			<div class="form-field">
				<label for="email">Email address</label>
				<input type="email" id="email" name="email" autocomplete="email" placeholder="you@example.com" required>
			</div>

			<div class="form-field">
				<label for="password">Password</label>
				<input type="password" id="password" name="password" autocomplete="new-password" placeholder="At least 8 characters" minlength="8" required>
			</div>

			<div class="form-field">
				<label for="name">Full name</label>
				<input type="text" id="name" name="name" autocomplete="name" placeholder="Your full name" minlength="2" pattern="[A-Za-zÀ-ÖØ-öø-ÿ .'-]+" required>
			</div>

			<div class="form-field">
				<label for="phone">Phone number</label>
				<input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+1 555 123 4567" pattern="[0-9+() .-]{7,}" required>
			</div>

			<div class="form-field form-field-wide">
				<label for="address">Address</label>
				<input type="text" id="address" name="address" autocomplete="street-address" placeholder="Street, city, country" minlength="5" required>
			</div>

			<button class="auth-submit" type="submit">Create account</button>
		</form>

		<p class="auth-switch">Already have an account? <a href="/auth/login">Sign in</a></p>
	</section>
</main>


<%- include('../partials/footer') %>
